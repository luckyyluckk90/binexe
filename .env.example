# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Public site URL used for auth email redirect links
VITE_SITE_URL=https://binexe.vercel.app

# Supabase Dashboard → Authentication → Providers → Email:
# - Enable Email
# - Confirm email: ON (required — login blocked until verified)
# Redirect URLs must include: https://binexe.vercel.app/auth/callback
