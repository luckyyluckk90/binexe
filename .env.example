# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Public site URL used for auth email redirect links
VITE_SITE_URL=https://binexe.vercel.app

# Resend (Vercel serverless /api/signup + /api/send-confirmation)
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Binexe <onboarding@resend.dev>
# Until a domain is verified, Resend only delivers to RESEND_ALLOWED_TO
# (Gmail +aliases of that inbox are rewritten to the same mailbox).
# RESEND_ALLOWED_TO=luckyyluckk90@gmail.com
# After verifying a domain at resend.com/domains:
# MAIL_FROM=Binexe <noreply@yourdomain.com>

# Supabase Dashboard → Authentication → Providers → Email:
# - Enable Email
# - Confirm email: ON (required — login blocked until verified)
# Redirect URLs must include: https://binexe.vercel.app/auth/callback
