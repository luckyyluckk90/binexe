# === Client (Vite — baked into the browser build) ===
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Public site URL used for auth email redirect links
VITE_SITE_URL=https://binexe.vercel.app

# === Server (Vercel serverless: /api/signup, /api/send-confirmation, /api/reset-password) ===
# Never expose these with a VITE_ prefix. Set them in the Vercel project env
# (and optionally as GitHub Actions secrets for CI docs — deploy uses Vercel env).
#
# Supabase → Project Settings → API → service_role (secret)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret
#
# Resend → API Keys
# RESEND_API_KEY=re_xxx
#
# Until a domain is verified, Resend only delivers to RESEND_ALLOWED_TO
# (Gmail +aliases of that inbox are rewritten to the same mailbox).
# RESEND_ALLOWED_TO=luckyyluckk90@gmail.com
#
# Default sender while testing with Resend onboarding:
# MAIL_FROM=Binexe <onboarding@resend.dev>
# After verifying a domain at resend.com/domains:
# MAIL_FROM=Binexe <noreply@yourdomain.com>

# === Supabase Auth dashboard (not env vars) ===
# Authentication → Providers → Email:
# - Enable Email
# - Confirm email: ON (required — login blocked until verified)
# Authentication → URL Configuration:
# - Site URL: https://binexe.vercel.app (or your custom domain)
# - Redirect URLs must include: https://binexe.vercel.app/auth/callback
#   (and https://yourdomain.com/auth/callback when using a custom domain)
